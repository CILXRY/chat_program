{
  "name": "nebula-chat",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @nebula/web dev",
    "build": "pnpm --filter @nebula/web build",
    "check": "pnpm --filter @nebula/web check",
    "desktop:dev": "pnpm --filter @nebula/desktop dev",
    "desktop:build": "pnpm --filter @nebula/desktop build",
    "desktop:typecheck": "pnpm --filter @nebula/desktop typecheck",
    "desktop:dist": "pnpm --filter @nebula/desktop dist"
  }
}
