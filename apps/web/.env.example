# Client-side WebRTC ICE configuration (Vite exposes PUBLIC_* variables).
# Copy to apps/web/.env for development. For the production Docker stack,
# set these values in the root .env; they are passed as build args.

PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# A TURN server is required for reliable calls across NAT / the public internet.
# PUBLIC_TURN_URL=turn:turn.example.com:3478
# PUBLIC_TURN_USERNAME=nebula
# PUBLIC_TURN_CREDENTIAL=change-me

# Optional comma-separated list is supported:
# PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
