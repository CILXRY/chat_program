---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到页面 · Nebula">
  <div class="relative grid min-h-dvh place-items-center overflow-hidden px-6">
    <div class="aurora aurora-a"></div>
    <div class="relative text-center">
      <p class="text-sm font-medium tracking-[0.3em] text-accent-300">404</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight">这里什么也没有</h1>
      <p class="mt-3 text-sm text-mist-500">可能频道被删除了，或者链接写错了。</p>
      <a
        href="/app"
        class="mt-8 inline-flex items-center rounded-xl bg-accent-500 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-accent-400"
      >
        回到聊天
      </a>
    </div>
  </div>
</BaseLayout>
