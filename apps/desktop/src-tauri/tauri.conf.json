{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula",
  "version": "0.3.0",
  "identifier": "com.nebula.chat",
  "build": {
    "beforeDevCommand": "pnpm ui:build && pnpm ui:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm ui:build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
