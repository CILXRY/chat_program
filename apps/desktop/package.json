{
  "name": "@nebula/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nebula Windows desktop client",
  "author": {
    "name": "CILXRY"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:publish": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  }
}
