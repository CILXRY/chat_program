# Copy this file to .env and change the secrets before exposing the app.

POSTGRES_DB=nebula
POSTGRES_USER=nebula
POSTGRES_PASSWORD=nebula_dev_password

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# "Remember me" session length (days) and normal login session length (days).
JWT_REMEMBER_DAYS=30
JWT_SESSION_DAYS=1

# Seed two demo accounts (alice / bob, password: nebula123) on first start.
SEED_DEMO=true

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Caddy (production stack)
# :80 keeps plain HTTP; use https://<LAN-IP> or a public domain for HTTPS.
SITE_ADDRESS=:80
# Set to the LAN IP when SITE_ADDRESS uses a bare IP (no SNI for IP literals).
DEFAULT_SNI=localhost
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Optional HTTPS entry for the host-run dev server (requires `pnpm dev`).
# Start with: docker compose --profile https up -d
DEV_SITE_ADDRESS=https://localhost
DEV_DEFAULT_SNI=localhost
DEV_HTTPS_PORT=9443

# Optional: WebRTC ICE servers for the production web build.
# PUBLIC_STUN_URL=stun:stun.l.google.com:19302
# PUBLIC_TURN_URL=turn:turn.example.com:3478
# PUBLIC_TURN_USERNAME=nebula
# PUBLIC_TURN_CREDENTIAL=change-me
